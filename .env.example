# ==============================================================================
# Pihu-BreakThough Environment Configuration Template
# ==============================================================================
# Stage 1 runs cleanly without any of the external keys below.
# Copy this file to .env and configure as needed for local testing.

# Core Application Settings
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=change-this-in-production-to-a-strong-random-secret
MAX_CONTENT_LENGTH=4194304

# Database Configuration (Neon PostgreSQL via psycopg 3)
# Leave empty or omitted in Stage 1. /api/health will safely report 'NOT CONFIGURED'.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# External LLM Provider Keys (Deferred to subsequent stages)
# In Stage 1, all chat traffic is processed by the local deterministic provider.
GEMINI_API_KEY=
GROQ_API_KEY=
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct
OLLAMA_BASE_URL=http://localhost:11434
